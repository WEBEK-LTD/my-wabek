# ============================================================
# WABEK - Environment Variables
# Copy this to .env.local and fill in your values
# ============================================================

# App
NEXT_PUBLIC_APP_URL=https://your-domain.netlify.app
NEXT_PUBLIC_APP_NAME=WABEK
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ============================================================
# Supabase - Primary variables (used by WABEK code)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# Supabase - Aliases (Netlify adds these automatically)
# Copy the same values from above
# ============================================================
NEXT_PUBLIC_SUPABASE_DATABASE_URL=https://your-project.supabase.co
SUPABASE_DATABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ============================================================
# Stripe
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# WhatsApp - Meta Cloud API (RECOMMENDED - Official)
# ============================================================
WHATSAPP_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_API_VERSION=v18.0

# ============================================================
# Admin
# ============================================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_SECRET_KEY=your-admin-secret-for-initial-setup

# ============================================================
# WHMCS Integration
# ============================================================
WHMCS_URL=https://your-whmcs.com
WHMCS_API_IDENTIFIER=your-whmcs-api-identifier
WHMCS_API_SECRET=your-whmcs-api-secret

# ============================================================
# Email (for notifications)
# ============================================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@wabek.com

# ============================================================
# Rate Limiting (optional - Upstash Redis)
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# OTP
OTP_EXPIRY_MINUTES=10

# ============================================================
# WhatsApp Web (Baileys) - Optional, for QR-based connections
# See docs/baileys-server.md for setup
# ============================================================
WA_WEB_SERVER_URL=https://your-vps:3001
WA_WEB_SERVER_SECRET=your-random-baileys-server-secret

# Netlify subdomain — used as CNAME target for white-label custom domains
NEXT_PUBLIC_NETLIFY_URL=https://wabek.netlify.app
