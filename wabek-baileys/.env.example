# WABEK Baileys Server — Environment Variables
# Copy this to .env and fill in values

# Required: Secret key to protect your server
SERVER_SECRET=change-this-to-random-secret-key

# Required: Your WABEK Netlify URL for receiving events
WABEK_EVENTS_URL=https://YOUR-SITE.netlify.app/api/whatsapp/wa-web-events

# Optional: Same as SERVER_SECRET or different
WABEK_EVENTS_SECRET=change-this-to-random-secret-key

# Auto-set by Railway/Render:
# PORT=3001
